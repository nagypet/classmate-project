<configuration>
	<appender name="spring-message" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-36X{traceId:-}] %-5p SPR [%-15.15t] %-30.30c{1}%4L [%X{batchId:-}] : %m %n</pattern>
		</encoder>
	</appender>

	<appender name="application-message" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-36X{traceId:-}] %-5p --- [%-15.15t] %-30.30c{1}%4L [%X{batchId:-}] : %m %n</pattern>
		</encoder>
	</appender>

	<!-- Spring framework loggers -->
	<logger name="org.reflections" level="ERROR"/>
	<logger name="org.springframework.security.authentication" level="DEBUG"/>
	<logger name="org.springframework.boot.web.embedded.tomcat" level="INFO"/>
	<!--	<logger name="org.springframework.cache" level="TRACE"/>-->
	<logger name="com.zaxxer.hikari.HikariConfig" level="INFO"/>
	<logger name="com.zaxxer.hikari" level="ERROR"/>
	<!--	<logger name="org.hibernate.SQL" level="DEBUG"/>-->
	<!--	<logger name="org.springframework.orm.jpa" level="DEBUG"/>-->
	<!--	<logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>-->
	<logger name="com.thoughtworks.xstream" level="OFF"/>
	<logger name="org.apache.tomcat.util.net.NioEndpoint" level="OFF"/>
	<logger name="org.apache.coyote.http11.Http11NioProtocol" level="OFF"/>
	<logger name="org.apache.coyote.http11.Http11Processor" level="OFF"/>
	<logger name="com.querydsl" level="DEBUG"/>
	<logger name="org.apache.sshd.client.keyverifier" level="ERROR"/>

	<!--
	<logger name="org.springframework.transaction.interceptor" level="TRACE"/>
	-->


	<!-- Spvitamin loggers -->
	<logger name="hu.perit.spvitamin" level="INFO" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.data" level="WARN" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.data.autoconfiguration" level="INFO" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.core.took" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.keystore" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.httplogging" level="OFF" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.restmethodlogger" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.security" level="TRACE" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.connectablecontext" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.SpvitaminApplication" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.exceptionhandler" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.feignclients" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.session" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.filestorage" level="WARN" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="hu.perit.spvitamin.spring.resilientjobrunner" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>

	<logger name="hu.perit.ngface" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>


	<!-- Application specific loggers -->
	<logger name="hu.perit.classmate" level="TRACE" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>
	<logger name="sun.security.ssl" level="DEBUG" additivity="false">
		<appender-ref ref="application-message"/>
	</logger>

	<root level="WARN">
		<appender-ref ref="spring-message"/>
	</root>
</configuration>
